{
  "manifest_version": 3,
  "name": "Flashcard Generator",
  "version": "1.0.0",
  "description": "Generate flashcards from the page you're viewing.",
  "key": "",
  "permissions": [
    "nativeMessaging",
    "activeTab",
    "scripting",
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*"
  ],
  "action": {
    "default_popup": "popup.html"
  }
}
