# Local secrets - not committed. Copy to .env and fill in.
# The Anthropic API key used by submissions/llm.py for card generation.
ANTHROPIC_API_KEY=

# Optional overrides (see README):
# EXTENSION_ID=  # set automatically by `manage.py install_native_host`
# LLM_MODEL=claude-sonnet-5
# LLM_PROVIDER=anthropic
# LLM_PROVIDER also accepts: openai (alias openai-compatible) | grok |
# gemini | openrouter - see the provider-specific blocks below.
# OpenAI-compatible provider (issue #27):
# OPENAI_API_KEY=
# LLM_PROVIDER=openai-compatible
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_MODEL=gpt-4o-mini
# LLM_OPENAI_API_KEY_ENV_VAR=OPENAI_API_KEY
# Grok provider (issue #84; xAI's OpenAI-compatible endpoint):
# LLM_PROVIDER=grok
# XAI_API_KEY=
# LLM_MODEL=grok-4
# Grok has no LLM_GROK_BASE_URL / LLM_GROK_API_KEY_ENV_VAR / LLM_GROK_MODEL
# override settings - the base URL (https://api.x.ai/v1) and the
# XAI_API_KEY default are hardcoded constants (v1 scope decision, #84).
# OpenRouter provider (issue #84; also OpenAI-compatible):
# LLM_PROVIDER=openrouter
# OPENROUTER_API_KEY=
# LLM_MODEL=anthropic/claude-3.5-sonnet  # OpenRouter model ids are
# origin-prefixed (e.g. anthropic/claude-3.5-sonnet, openai/gpt-4o) - don't
# assume a bare/native model name or something like openrouter/auto.
# Like Grok, there are no LLM_OPENROUTER_* override settings - the base URL
# (https://openrouter.ai/api/v1) and the OPENROUTER_API_KEY default are
# hardcoded constants.
# Gemini provider (issue #83; Google's Generative Language API):
# LLM_PROVIDER=gemini
# GOOGLE_API_KEY=  # must be paired with LLM_GEMINI_API_KEY_ENV_VAR=GOOGLE_API_KEY
#                  # (or the generic LLM_API_KEY_ENV_VAR=GOOGLE_API_KEY) -
#                  # unlike Grok/OpenRouter, no default env-var name is
#                  # hardcoded for Gemini's key
# LLM_GEMINI_API_KEY_ENV_VAR=GOOGLE_API_KEY
# LLM_GEMINI_MODEL=gemini-2.0-flash  # optional override of LLM_MODEL
# Gemini has no LLM_GEMINI_BASE_URL setting - the endpoint is a fixed
# constant in submissions/llm.py, not configurable.
