# Local secrets - not committed. Copy to .env and fill in.
# The Anthropic API key used by submissions/llm.py for card generation.
ANTHROPIC_API_KEY=

# Optional overrides (see README):
# EXTENSION_ID=  # set automatically by `manage.py install_native_host`
# LLM_MODEL=claude-sonnet-5
# LLM_PROVIDER=anthropic
# OpenAI-compatible provider (issue #27):
# OPENAI_API_KEY=
# LLM_PROVIDER=openai-compatible
# LLM_OPENAI_BASE_URL=https://api.openai.com/v1
# LLM_OPENAI_MODEL=gpt-4o-mini
# LLM_OPENAI_API_KEY_ENV_VAR=OPENAI_API_KEY
